# =====================================================
# LA ESQUINITA - Variables de Entorno
# =====================================================
# Copia este archivo como .env y completa los valores
# cp .env.example .env
# =====================================================

# Puerto del servidor
PORT=4000

# URL del frontend (para CORS)
FRONTEND_URL=http://localhost:3000

# MongoDB
# Local:
MONGO_URI=mongodb://localhost:27017/laesquinita
# Atlas (cloud):
# MONGO_URI=mongodb+srv://usuario:password@cluster.xxxxx.mongodb.net/laesquinita
